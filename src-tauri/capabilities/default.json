{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main Bentomux window",
  "windows": ["main", "approval-overlay"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "updater:default",
    "process:allow-restart",
    "opener:default"
  ]
}
