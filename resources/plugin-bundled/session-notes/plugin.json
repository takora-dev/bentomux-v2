{
  "id": "bentomux.session-notes",
  "name": "Session Notes",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "Jot a note against the workspace you are in, and see the latest one on the welcome page.",
  "author": "Bentomux",
  "entry": "index.js",
  "icon": { "type": "builtin", "name": "lines" },
  "permissions": ["storage", "app.read"],
  "contributes": {
    "commands": [
      { "id": "bentomux.session-notes.open", "title": "Session Notes: Open" },
      { "id": "bentomux.session-notes.add", "title": "Session Notes: Add a note" }
    ],
    "widgets": [
      { "id": "bentomux.session-notes.widget", "title": "Latest note" }
    ],
    "modals": [
      { "id": "bentomux.session-notes.modal", "title": "Session Notes" }
    ],
    "dock": [
      {
        "id": "bentomux.session-notes.dock",
        "title": "Session Notes",
        "icon": { "type": "builtin", "name": "lines" },
        "command": "bentomux.session-notes.open"
      }
    ]
  }
}
